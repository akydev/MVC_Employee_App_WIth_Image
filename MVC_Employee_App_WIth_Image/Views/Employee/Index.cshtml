@using MVC_Employee_App_WIth_Image.ViewModel
@model IEnumerable<EmployeeViewModel>

@{
    ViewData["Title"] = "Employee Directory";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f6f9;
    }

    .page-header {
        font-weight: 700;
        font-size: 28px;
        color: #1f2937;
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        border: none;
    }

    .profile-img {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #dee2e6;
    }

    .btn-brand {
        background: #4f46e5;
        color: white;
        border-radius: 8px;
    }

    .btn-brand:hover {
        background: #4338ca;
        color: white;
    }

    .action-btn i {
        font-size: 14px;
    }

    table.dataTable thead {
        background: #111827;
        color: white;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 5px 10px;
        border-radius: 5px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: #4f46e5;
        color: white;
    }

    .header-controls {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .header-controls input {
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        padding: 8px 12px;
    }

    .export-btn {
        background: #10b981;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 8px 15px;
        cursor: pointer;
    }

    .export-btn:hover {
        background: #059669;
        color: white;
    }

    .no-data {
        text-align: center;
        padding: 40px;
        color: #999;
    }

    .search-box {
        margin-bottom: 15px;
    }
</style>

<div class="container mt-4">
    @* for post delete request, we need to send anti-forgery token for security. so we can include it in the page and then read its value in javascript when user confirms delete action. *@
    @Html.AntiForgeryToken() 
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4" style="flex-wrap: wrap; gap: 15px;">
        <div class="page-header">
            Employee Directory
        </div>

        <div class="header-controls">
            <input type="text" id="searchInput" class="form-control" placeholder="Search employees..." style="width: 200px;" />
            <button onclick="exportToPDF()" class="export-btn">
                <i class="fas fa-file-pdf"></i> Export PDF
            </button>
            <a asp-action="Create" class="btn btn-brand">
                <i class="fa fa-plus"></i> Add Employee
            </a>
        </div>
    </div>

    <!-- CARD -->
    <div class="card card-custom p-3">

        <div class="table-responsive">
            @if (Model.Count() == 0)
            {
                <div class="no-data">
                    <i class="fas fa-inbox" style="font-size: 48px; color: #ddd;"></i>
                    <p style="margin-top: 15px;">No employees found. <a asp-action="Create">Add one now!</a></p>
                </div>
            }
            else
            {
                <table id="employeeTable" class="table align-middle">
                    <thead>
                        <tr>
                            <th>Profile</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Document</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- PROFILE IMAGE -->
                                <td>
                                    <img src="~/Uploads/Images/@item.Profile_Pic" class="profile-img" alt="Profile" />
                                </td>

                                <!-- NAME -->
                                <td>
                                    <strong>@item.First_Name @item.Last_Name</strong>
                                </td>

                                <!-- EMAIL -->
                                <td>
                                    <span class="text-muted">@item.Email_Address</span>
                                </td>

                                <!-- ADDRESS -->
                                <td>
                                    @item.Home_Address
                                </td>

                                <!-- DOCUMENT -->
                                <td>
                                    <a href="~/Uploads/Docs/@item.Address_Proof" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa fa-file"></i> View
                                    </a>
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.EmpId" class="btn btn-sm btn-outline-primary action-btn">
                                        <i class="fa fa-edit"></i>
                                    </a>

                                    <button onclick="confirmDelete(@item.EmpId)" class="btn btn-sm btn-outline-danger action-btn">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            }
        </div>

    </div>
</div>

<!-- SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    let dataTableInstance;

    $(document).ready(function () {
        // Initialize DataTable with custom features
        dataTableInstance = $('#employeeTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            order: [[1, 'asc']],
            columnDefs: [
                { targets: [4, 5], orderable: false }
            ]
        });

        // Search functionality
        $('#searchInput').on('keyup', function () {
            dataTableInstance.search(this.value).draw();
        });
    });

       function confirmDelete(id) {
        Swal.fire({
            title: "Delete Employee?",
            text: "This action cannot be undone.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {

                // create form dynamically
                const form = document.createElement("form");
                form.method = "POST";
                form.action = "/Employee/Delete/" + id;

                // anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "__RequestVerificationToken";
                input.value = token;

                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        });
    }

        function exportToPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        let yPosition = 20;

        // Title
        doc.setFontSize(18);
        doc.setTextColor(102, 126, 234);
        doc.text('Employee Directory Report', pageWidth / 2, yPosition, { align: 'center' });

        yPosition += 12;

        // Date
        doc.setFontSize(10);
        doc.setTextColor(100, 100, 100);
        doc.text('Generated on: ' + new Date().toLocaleDateString(), pageWidth / 2, yPosition, { align: 'center' });

        yPosition += 15;

        const rows = document.querySelectorAll('#employeeTable tbody tr');

        rows.forEach((row, index) => {

            // Page break
            if (yPosition > pageHeight - 40) {
                doc.addPage();
                yPosition = 20;
            }

            const cells = row.querySelectorAll('td');

            const img = cells[0].querySelector('img');
            const name = cells[1].textContent.trim();
            const email = cells[2].textContent.trim();
            const address = cells[3].textContent.trim();

            // Header per employee
            doc.setFontSize(11);
            doc.setFont(undefined, 'bold');
            doc.setTextColor(0, 0, 0);
            doc.text(`Employee ${index + 1}`, 20, yPosition);

            yPosition += 7;
            doc.setFont(undefined, 'normal');
            doc.setFontSize(10);

            // Image + Details layout
            if (img && img.src) {
                try {
                    doc.addImage(img.src, 'JPEG', 20, yPosition, 25, 25);
                } catch (e) {
                    console.log("Image error:", e);
                }
            }

            let textX = img && img.src ? 50 : 20;

            doc.text(`Name: ${name}`, textX, yPosition);
            yPosition += 6;

            doc.text(`Email: ${email}`, textX, yPosition);
            yPosition += 6;

            doc.text(`Address: ${address}`, textX, yPosition);
            yPosition += 6;

            // Document status (IMPORTANT FIX)
            doc.text('Document: Uploaded [OK]', textX, yPosition);
            yPosition += 12;

            // Divider
            doc.setDrawColor(200);
            doc.line(20, yPosition, pageWidth - 20, yPosition);

            yPosition += 10;
        });

        // Footer
        doc.setFontSize(9);
        doc.setTextColor(150);
        doc.text(
            'Employee Management System',
            pageWidth / 2,
            pageHeight - 10,
            { align: 'center' }
        );

        doc.save(`EmployeeDirectory_${new Date().toISOString().split('T')[0]}.pdf`);
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
