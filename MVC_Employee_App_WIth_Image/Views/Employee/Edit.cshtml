@model MVC_Employee_App_WIth_Image.Models.EmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f6f9;
    }

    .form-container {
        max-width: 900px;
        margin: auto;
    }

    .card-custom {
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: none;
    }

    .form-title {
        font-size: 26px;
        font-weight: 700;
        color: #1f2937;
    }

    .btn-brand {
        background: #4f46e5;
        color: white;
        border-radius: 8px;
    }

        .btn-brand:hover {
            background: #4338ca;
        }

    .preview-img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px dashed #ccc;
        padding: 5px;
    }

    .file-box {
        border: 2px dashed #d1d5db;
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        cursor: pointer;
    }

        .file-box:hover {
            background: #f9fafb;
        }
</style>

<div class="container mt-5 form-container">

    <div class="card card-custom p-4">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-title">Edit Employee</div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">

            <!-- Hidden Fields -->
            <input type="hidden" asp-for="EmpId" />
            <input type="hidden" asp-for="Profile_Pic" />
            <input type="hidden" asp-for="Address_Proof" />

            <div class="row g-4">

                <!-- LEFT SIDE -->
                <div class="col-md-6">

                    <div class="form-floating mb-3">
                        <input asp-for="First_Name" class="form-control" />
                        <label>First Name</label>
                        <span asp-validation-for="First_Name" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Last_Name" class="form-control" />
                        <label>Last Name</label>
                        <span asp-validation-for="Last_Name" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email_Address" class="form-control" />
                        <label>Email Address</label>
                        <span asp-validation-for="Email_Address" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Home_Address" class="form-control" style="height: 100px"></textarea>
                        <label>Home Address</label>
                        <span asp-validation-for="Home_Address" class="text-danger"></span>
                    </div>

                </div>

                <!-- RIGHT SIDE -->
                <div class="col-md-6 text-center">

                    <!-- CURRENT IMAGE -->
                    <div class="mb-2">
                        <img id="imgPreview"
                             src="~/Uploads/Images/@Model.Profile_Pic"
                             class="preview-img" />
                    </div>

                    <small class="text-muted d-block mb-2">Current Profile Image</small>

                    <!-- NEW IMAGE -->
                    <div class="mb-4">
                        <input type="file"
                               asp-for="ProfileImage"
                               id="ProfileImage"
                               class="form-control" />

                        <small class="text-muted">Upload new image (optional)</small>
                    </div>

                    <!-- CURRENT DOCUMENT -->
                    <div class="mb-2">
                        <a href="~/Uploads/Docs/@Model.Address_Proof"
                           target="_blank"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="fa fa-file"></i> View Current Document
                        </a>
                    </div>

                    <!-- NEW DOCUMENT -->
                    <div class="file-box mb-2">
                        <input type="file"
                               asp-for="AddressProofFile"
                               id="AddressProofFile"
                               class="form-control" />

                        <p class="mt-2 mb-0">
                            <i class="fa fa-upload"></i> Upload New Document
                        </p>
                    </div>

                    <div id="fileName" class="text-muted small"></div>

                </div>

            </div>

            <!-- SUBMIT -->
            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-brand px-4">
                    <i class="fa fa-save"></i> Update Employee
                </button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/employee.js"></script>
}

